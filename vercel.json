{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=900" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://server-32bo.onrender.com/sitemap/sitemap.xml" },
    { "source": "/sitemap-index.xml", "destination": "https://server-32bo.onrender.com/sitemap-index.xml" },
    { "source": "/robots.txt", "destination": "https://server-32bo.onrender.com/robots.txt" },
    { "source": "/sitemap/:path*", "destination": "https://server-32bo.onrender.com/sitemap/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}